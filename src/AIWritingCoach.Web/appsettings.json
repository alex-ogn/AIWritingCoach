{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "App": {
    "Mode": "Personal",
    "Port": 5155,
    "OpenBrowser": false
  },

  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": true
  },

  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=AIWritingCoach;Trusted_Connection=True;TrustServerCertificate=True",
    "PostgreSql": "Host=localhost;Database=aiwritingcoach;Username=postgres",
    "Sqlite": "Data Source=aiwritingcoach.db"
  },

  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "DefaultModel": "google/gemma-4-31b-it:free",
    "FallbackModels": [
      "nvidia/nemotron-3.5-super-vl:free",
      "google/gemma-4-26b-a4b-it:free",
      "openai/gpt-4o-mini"
    ],
    "MaxRetriesPerModel": 2,
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:00:30",
    "Timeout": "00:02:00",
    "UseJsonSchema": true,
    "MaxParseAttempts": 2
  }
}
