@page "/"
@page "/write/{Id:guid}"
@using AIWritingCoach.Core.Ai
@using AIWritingCoach.Core.Common
@inject WritingCoachService Coach
@inject IDocumentRepository Documents
@inject IReviewRepository Reviews
@inject IProfileRepository ProfileRepository
@inject IRubricRepository RubricRepository
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@L["Write.PageTitle"]</PageTitle>

@if (_document is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

<div class="write-toolbar">
    <MudSelect T="Profile" Value="_profile" ValueChanged="OnProfileChanged" Label="@L["Write.Profile"]"
               ToStringFunc="@(p => p?.Name ?? string.Empty)" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="tb-profile">
        @foreach (var profile in _profiles)
        {
            <MudSelectItem T="Profile" Value="profile">@profile.Name</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="CefrLevel" @bind-Value="_document.TargetLevel" Disabled="LevelLocked" Label="@L["Write.Level"]" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="tb-small">
        @foreach (var level in Enum.GetValues<CefrLevel>())
        {
            <MudSelectItem T="CefrLevel" Value="level">@level</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="WritingTaskType" @bind-Value="_document.TaskType" Disabled="TaskTypeLocked" Label="@L["Write.TaskType"]" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="tb-task"
               ToStringFunc="@(t => L[$"TaskType.{t}"])">
        @foreach (var type in Enum.GetValues<WritingTaskType>())
        {
            <MudSelectItem T="WritingTaskType" Value="type">@L[$"TaskType.{type}"]</MudSelectItem>
        }
    </MudSelect>

    <div class="criteria-anchor">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune" OnClick="() => _criteriaOpen = !_criteriaOpen">
            @L["Write.Criteria", _selectedCriteria.Count]
        </MudButton>
        <MudPopover Open="_criteriaOpen" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Paper="true" Elevation="8" Class="criteria-popover">
            @foreach (var (rubric, criteria) in CriteriaPool())
            {
                <MudText Typo="Typo.overline">@rubric.Name</MudText>
                @foreach (var criterion in criteria)
                {
                    <div title="@criterion.Description">
                        <MudCheckBox T="bool" Value="_selectedCriteria.Contains(criterion.Key)" ValueChanged="v => ToggleCriterion(criterion.Key, v)"
                                     Label="@($"{criterion.Name} ({criterion.MinScore}–{criterion.MaxScore})")" Dense="true" Size="Size.Small" />
                    </div>
                }
            }
            <div class="d-flex justify-end">
                <MudButton Size="Size.Small" OnClick="() => _criteriaOpen = false">@L["Common.Close"]</MudButton>
            </div>
        </MudPopover>
        <MudOverlay Visible="_criteriaOpen" OnClick="() => _criteriaOpen = false" AutoClose="true" />
    </div>

    <MudToggleGroup T="ViewMode" Value="_viewMode" ValueChanged="v => _viewMode = v" Size="Size.Small" Color="Color.Primary" Outlined="true" Class="tb-view">
        <MudToggleItem T="ViewMode" Value="ViewMode.Edit" Text="@L["Write.View.Edit"]" />
        <MudToggleItem T="ViewMode" Value="ViewMode.SideBySide" Text="@L["Write.View.SideBySide"]" Disabled="_session is null" />
        <MudToggleItem T="ViewMode" Value="ViewMode.Inline" Text="@L["Write.View.Inline"]" Disabled="_session is null" />
    </MudToggleGroup>

    <MudSpacer />

    <MudChip T="string" Color="WordCountColor()" Variant="Variant.Outlined" Size="Size.Small">
        @L["Write.Words", WordCount, WordLimitText()]
    </MudChip>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_checking || string.IsNullOrWhiteSpace(_document.Content)"
               StartIcon="@Icons.Material.Filled.Spellcheck" OnClick="CheckAsync">
        @if (_checking)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            @L["Write.Checking"]
        }
        else
        {
            @L["Write.Check"]
        }
    </MudButton>

    <MudIconButton Icon="@(_panelOpen ? Icons.Material.Filled.KeyboardDoubleArrowRight : Icons.Material.Filled.KeyboardDoubleArrowLeft)"
                   Disabled="_session is null" OnClick="() => _panelOpen = !_panelOpen" aria-label="@L["Write.TogglePanel"]" />
    <MudIconButton Icon="@Icons.Material.Filled.NoteAdd" Href="/" aria-label="@L["Write.New"]" title="@L["Write.New"]" />
</div>

<div class="write-grid @(_panelOpen && _session is not null ? "with-panel" : null)">
    <section class="write-main">
        <MudTextField T="string" @bind-Value="_document.Title" Placeholder="@L["Write.TitlePlaceholder"]" Variant="Variant.Text"
                      Class="title-field" DebounceInterval="800" OnDebounceIntervalElapsed="_ => AutoSaveAsync()" />
        <MudTextField T="string" @bind-Value="_document.TaskPrompt" Label="@L["Write.TaskPrompt"]" Variant="Variant.Outlined"
                      Lines="2" Sizing="InputSizing.Auto" MaxLines="6" Margin="Margin.Dense" Class="mb-2"
                      DebounceInterval="800" OnDebounceIntervalElapsed="_ => AutoSaveAsync()" />

        @if (_viewMode == ViewMode.Edit)
        {
            @if (IsStale)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@L["Write.Stale"]</MudAlert>
            }
            <MudTextField T="string" @bind-Value="_document.Content" Placeholder="@L["Write.ContentPlaceholder"]" Variant="Variant.Outlined"
                          Lines="22" Class="editor" Immediate="false" DebounceInterval="1500" OnDebounceIntervalElapsed="_ => AutoSaveAsync()" />
        }
        else if (_session is not null)
        {
            var selected = SelectedHunkOrNull;
            <div class="hunk-toolbar">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="_session.Diff.Hunks.Count == 0" OnClick="() => MoveHunk(-1)" aria-label="@L["Diff.Previous"]" />
                <MudText Typo="Typo.body2">
                    @if (selected is null)
                    {
                        @L["Diff.Summary", _session.Diff.Hunks.Count, _session.Diff.Hunks.Count(h => h.Accepted)]
                    }
                    else
                    {
                        @L["Diff.Position", selected.Index + 1, _session.Diff.Hunks.Count]
                    }
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="_session.Diff.Hunks.Count == 0" OnClick="() => MoveHunk(1)" aria-label="@L["Diff.Next"]" />
                @if (selected is not null)
                {
                    <MudButton Size="Size.Small" Variant="@(selected.Accepted ? Variant.Filled : Variant.Outlined)" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" OnClick="() => DecideAsync(selected, true)">@L["Diff.Accept"]</MudButton>
                    <MudButton Size="Size.Small" Variant="@(!selected.Accepted ? Variant.Filled : Variant.Outlined)" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close" OnClick="() => DecideAsync(selected, false)">@L["Diff.Reject"]</MudButton>
                }
                <MudSpacer />
                <MudButton Size="Size.Small" OnClick="() => SetAllAsync(true)">@L["Diff.AcceptAll"]</MudButton>
                <MudButton Size="Size.Small" OnClick="() => SetAllAsync(false)">@L["Diff.RejectAll"]</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="ApplyAsync">
                    @L["Diff.Apply"]
                </MudButton>
            </div>

            @if (_viewMode == ViewMode.SideBySide)
            {
                <SideBySideDiff Diff="_session.Diff" Errors="_session.Review.Errors" SelectedHunk="_selectedHunk" OnSelect="SelectHunk" />
            }
            else
            {
                <InlineDiff Diff="_session.Diff" Errors="_session.Review.Errors" SelectedHunk="_selectedHunk" OnSelect="SelectHunk" />
            }
        }
    </section>

    @if (_panelOpen && _session is not null)
    {
        <aside class="write-panel">
            <ReviewPanel Session="_session" SelectedError="_selectedError" OnSelectError="SelectError" />
        </aside>
    }
</div>

@code {
    private enum ViewMode
    {
        Edit,
        SideBySide,
        Inline,
    }

    private const string DefaultProfileKey = "quick-proofread";

    [Parameter]
    public Guid? Id { get; set; }

    private IReadOnlyList<Profile> _profiles = [];
    private IReadOnlyList<Rubric> _rubrics = [];
    private WritingDocument? _document;
    private bool _isNew;
    private Profile? _profile;
    private HashSet<string> _selectedCriteria = [];
    private ReviewSession? _session;
    private ViewMode _viewMode = ViewMode.Edit;
    private bool _criteriaOpen;
    private bool _panelOpen = true;
    private bool _checking;
    private int? _selectedHunk;
    private int? _selectedError;
    private string? _scrollToId;

    private int WordCount => TextStats.CountWords(_document?.Content);

    private DiffHunk? SelectedHunkOrNull => _session?.Diff.Hunks.FirstOrDefault(h => h.Index == _selectedHunk);

    private bool IsStale => _session is not null
        && _document is not null
        && _document.Content != _session.Review.SubmittedText
        && _document.Content != _session.Review.FinalText;

    protected override async Task OnParametersSetAsync()
    {
        if (_profiles.Count == 0)
        {
            _profiles = await ProfileRepository.ListAsync();
            _rubrics = await RubricRepository.ListAsync();
        }

        if (Id is { } id)
        {
            if (_document?.Id == id)
            {
                return; // Our own URL update after the first save.
            }

            var document = await Documents.GetAsync(id);
            if (document is null)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            await LoadAsync(document);
        }
        else
        {
            NewDocument();
        }
    }

    private async Task LoadAsync(WritingDocument document)
    {
        _document = document;
        _isNew = false;
        _profile = _profiles.FirstOrDefault(p => p.Id == document.ProfileId) ?? _profiles.FirstOrDefault();
        _selectedCriteria = [.. _profile?.CriterionKeys ?? []];
        _session = null;
        _selectedHunk = null;
        _selectedError = null;

        if (document.LastReviewId is { } reviewId && await Reviews.GetAsync(reviewId) is { } review)
        {
            _session = Coach.Open(review);
        }

        _viewMode = _session is not null && !IsStale ? ViewMode.Inline : ViewMode.Edit;
    }

    private void NewDocument()
    {
        _profile = _profiles.FirstOrDefault(p => p.Key == DefaultProfileKey) ?? _profiles.FirstOrDefault();
        _document = new WritingDocument
        {
            TaskType = _profile?.TaskType ?? WritingTaskType.Essay,
            TargetLevel = _profile?.TargetLevel ?? CefrLevel.B2,
            ProfileId = _profile?.Id,
        };
        _selectedCriteria = [.. _profile?.CriterionKeys ?? []];
        _isNew = true;
        _session = null;
        _viewMode = ViewMode.Edit;
        _selectedHunk = null;
        _selectedError = null;
    }

    private void OnProfileChanged(Profile profile)
    {
        _profile = profile;
        _selectedCriteria = [.. profile.CriterionKeys];
        _document!.ProfileId = profile.Id;
        _document.TaskType = profile.TaskType;
        _document.TargetLevel = profile.TargetLevel;
    }

    // Exam profiles (A2–C2) fix both level and task type, so their rubric and word limits always fit.
    // A profile for a specific kind of text (Business email) fixes the task type but not the level;
    // Quick proofread (task type "Other") leaves both free.
    private bool LevelLocked => _profile is not null && IsExamProfile(_profile);

    private bool TaskTypeLocked => _profile is not null && (LevelLocked || _profile.TaskType != WritingTaskType.Other);

    private bool IsExamProfile(Profile profile) =>
        _rubrics.Any(r => r.Id == profile.RubricId && r.Kind == RubricKind.Exam);

    /// <summary>The profile's own rubric first, then every custom-criteria rubric.</summary>
    private IEnumerable<(Rubric Rubric, IReadOnlyList<RubricCriterion> Criteria)> CriteriaPool()
    {
        var main = _rubrics.FirstOrDefault(r => r.Id == _profile?.RubricId);
        if (main is not null && main.Kind == RubricKind.Exam)
        {
            yield return (main, main.Criteria);
        }

        foreach (var custom in _rubrics.Where(r => r.Kind == RubricKind.Custom))
        {
            yield return (custom, custom.Criteria);
        }
    }

    private void ToggleCriterion(string key, bool enabled)
    {
        if (enabled)
        {
            _selectedCriteria.Add(key);
        }
        else
        {
            _selectedCriteria.Remove(key);
        }
    }

    private string WordLimitText() => (_profile?.MinWords, _profile?.MaxWords) switch
    {
        (int min, int max) => $" / {min}–{max}",
        (int min, null) => $" / ≥{min}",
        (null, int max) => $" / ≤{max}",
        _ => string.Empty,
    };

    private Color WordCountColor()
    {
        var count = WordCount;
        if (count == 0 || _profile is null)
        {
            return Color.Default;
        }

        return (_profile.MinWords is { } min && count < min) || (_profile.MaxWords is { } max && count > max)
            ? Color.Warning
            : Color.Success;
    }

    private async Task AutoSaveAsync()
    {
        if (_document is null || (_isNew && string.IsNullOrWhiteSpace(_document.Content)))
        {
            return;
        }

        EnsureTitle();
        _document.WordCount = WordCount;
        await Documents.SaveAsync(_document);
        AfterFirstSave();
    }

    private void EnsureTitle()
    {
        if (string.IsNullOrWhiteSpace(_document!.Title))
        {
            var firstLine = _document.Content.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault() ?? string.Empty;
            _document.Title = firstLine.Length > 60 ? firstLine[..60].TrimEnd() + "…" : firstLine;
        }
    }

    private void AfterFirstSave()
    {
        if (_isNew)
        {
            _isNew = false;
            Navigation.NavigateTo($"/write/{_document!.Id}", replace: true);
        }
    }

    private async Task CheckAsync()
    {
        if (_document is null || string.IsNullOrWhiteSpace(_document.Content))
        {
            return;
        }

        _checking = true;
        try
        {
            EnsureTitle();
            var criteria = CriteriaPool()
                .SelectMany(g => g.Criteria)
                .Where(c => _selectedCriteria.Contains(c.Key))
                .DistinctBy(c => c.Key)
                .ToList();

            _session = await Coach.CheckAsync(_document, new CheckOptions
            {
                ProfileId = _profile?.Id,
                RubricId = _profile?.RubricId,
                Criteria = criteria,
                Model = _profile?.Model,
                MinWords = _profile?.MinWords,
                MaxWords = _profile?.MaxWords,
            });

            AfterFirstSave();
            _selectedHunk = null;
            _selectedError = null;
            _panelOpen = true;
            if (_viewMode == ViewMode.Edit)
            {
                _viewMode = ViewMode.Inline;
            }

            Snackbar.Add(L["Write.CheckDone", _session.Diff.Hunks.Count], Severity.Success);
        }
        catch (AiReviewException ex)
        {
            var details = ex.Reason == AiReviewFailure.NotConfigured ? string.Empty : $" {ex.Message}";
            Snackbar.Add($"{L[$"Ai.Error.{ex.Reason}"]}{details}", Severity.Error, o => o.VisibleStateDuration = 12000);
        }
        finally
        {
            _checking = false;
        }
    }

    private void SelectHunk(DiffHunk hunk)
    {
        _selectedHunk = hunk.Index;
        _selectedError = hunk.ErrorIndexes.Count > 0 ? hunk.ErrorIndexes[0] : null;
        _scrollToId = _selectedError is { } e ? $"error-{e}" : null;
    }

    private void SelectError(ReviewError error)
    {
        _selectedError = error.Index;
        var hunk = _session?.Diff.HunksForError(error.Index).FirstOrDefault();
        _selectedHunk = hunk?.Index;
        if (_viewMode == ViewMode.Edit)
        {
            _viewMode = ViewMode.Inline;
        }

        _scrollToId = hunk is null ? null : DiffComponentBase.HunkElementId(hunk);
    }

    private void MoveHunk(int delta)
    {
        var hunks = _session!.Diff.Hunks;
        if (hunks.Count == 0)
        {
            return;
        }

        var current = _selectedHunk ?? (delta > 0 ? -1 : hunks.Count);
        var next = Math.Clamp(current + delta, 0, hunks.Count - 1);
        SelectHunk(hunks[next]);
        _scrollToId = DiffComponentBase.HunkElementId(hunks[next]);
    }

    private async Task DecideAsync(DiffHunk hunk, bool accepted)
    {
        hunk.Accepted = accepted;
        await Coach.SaveDecisionsAsync(_session!);
    }

    private async Task SetAllAsync(bool accepted)
    {
        _session!.Diff.SetAll(accepted);
        await Coach.SaveDecisionsAsync(_session);
    }

    private async Task ApplyAsync()
    {
        await Coach.ApplyAsync(_document!, _session!);
        _viewMode = ViewMode.Edit;
        Snackbar.Add(L["Write.Applied"], Severity.Success);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToId is { } id)
        {
            _scrollToId = null;
            await JS.InvokeVoidAsync("aiwc.scrollIntoView", id);
        }
    }
}
